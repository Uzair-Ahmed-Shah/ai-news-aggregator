

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   
  name      String?
  createdAt DateTime @default(now())
  notes     Note[]
  likes         ArticleLike[]
  savedArticles SavedArticle[]
  @@map("users")
}

model Article {
  id           String   @id @default(uuid())
  title        String
  url          String   @unique
  fullContent  String?  @db.Text 
  summary      String?  @db.Text
  deepSummary  String?  @db.Text
  imageUrl     String?
  curatorScore Float?   @default(0.0)
  sourceName   String
  category     String
  sentiment    String?
  impactType   String?
  publishedAt  DateTime
  createdAt    DateTime @default(now())
  likesCount     Int       @default(0)
  notes        Note[]
  savedBy      SavedArticle[]
  likes        ArticleLike[]
  @@index([category])
  @@index([sentiment])
  @@index([impactType])
  @@index([publishedAt])
  @@map("articles")
}

model ArticleLike {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  article   Article  @relation(fields: [articleId], references: [id])

  @@unique([userId, articleId])
  @@map("article_likes")
}

model SavedArticle {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  savedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  article   Article  @relation(fields: [articleId], references: [id])

  @@unique([userId, articleId])
  @@map("saved_articles")
}

model Note {
  id        String   @id @default(uuid())
  content   String   @db.Text
  userId    String
  articleId String
  user      User     @relation(fields: [userId], references: [id])
  article   Article  @relation(fields: [articleId], references: [id])
  createdAt DateTime @default(now())

  @@map("notes")
}


model WeeklyReport {
  id            Int      @id @default(autoincrement())
  title         String? 
  weekEndDate   DateTime
  topArticles   Json     
  trends        Json?    
  createdAt     DateTime @default(now())

  @@map("weekly_reports")
}
